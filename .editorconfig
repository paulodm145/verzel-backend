root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,json}]
max_line_length = 100

[*.md]
# Espaços à direita têm significado em markdown, e tabela não quebra em 100
# colunas sem virar ilegível
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
