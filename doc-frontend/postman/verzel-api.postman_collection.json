        {
          "name": "Criar evento (organizador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "Nasce DRAFT, com o mapa de assentos criado junto.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"550\",\n  \"sourceType\": \"MOVIE\",\n  \"title\": \"Clube da Luta — Sessão\",\n  \"description\": \"Sessão de estreia\",\n  \"imageUrl\": \"https://image.tmdb.org/t/p/w500/exemplo.jpg\",\n  \"date\": \"{{novaData}}\",\n  \"venue\": \"Cine Arena\",\n  \"capacity\": 30,\n  \"price\": 45\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O mesmo organizador não repete o mesmo item de catálogo na mesma",
                  "// data — a API responde 409. Uma data nova por execução evita o",
                  "// conflito com o evento do seed e com execuções anteriores.",
                  "const daquiADias = 60 + Math.floor(Math.random() * 300);",
                  "const data = new Date(Date.now() + daquiADias * 24 * 60 * 60 * 1000);",
                  "data.setUTCHours(21, 0, 0, 0);",
                  "pm.collectionVariables.set('novaData', data.toISOString());"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Garante o papel ORGANIZER antes de qualquer requisição desta pasta,",
                  "// para a coleção rodar inteira no Collection Runner sem intervenção.",
                  "if (pm.collectionVariables.get('papelAtual') !== 'ORGANIZER') {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/auth/login',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({",
                  "      email: 'organizador@verzel.test', password: 'organizador123'",
                  "    }) }",
                  "  }, (erro, resposta) => {",
                  "    if (erro) { console.error('login automático falhou', erro); return; }",
                  "    const sessao = resposta.json().session;",
                  "    pm.collectionVariables.set('accessToken', sessao.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', sessao.refreshToken);",
                  "    pm.collectionVariables.set('papelAtual', 'ORGANIZER');",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "// Guarda em variável própria: as rotas de publicar e cancelar",
                  "// operam sobre o evento que esta coleção criou, nunca sobre o",
                  "// evento do seed que as rotas públicas usam",
                  "if (corpo.id) pm.collectionVariables.set('meuEventoId', corpo.id);"
                ]
              }
            }
          ]
