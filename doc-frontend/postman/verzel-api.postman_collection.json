{
  "info": {
    "name": "Verzel — Plataforma de Eventos e Ingressos",
    "description": "API do desafio Elite Dev 2026.\n\n**Como usar:** rode `Autenticação > Login (cliente)` primeiro — o script de teste guarda o `accessToken` e o `refreshToken` nas variáveis da coleção, e todas as demais requisições passam a autenticar sozinhas.\n\nAs credenciais são as do seed (`npm run db:seed`), documentadas no README.\n\nO token de acesso dura 15 minutos. Quando expirar, rode `Renovar sessão` ou faça login de novo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "description": "Base da API"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "Preenchido pelo login"
    },
    {
      "key": "refreshToken",
      "value": "",
      "description": "Preenchido pelo login"
    },
    {
      "key": "eventId",
      "value": "",
      "description": "Preenchido ao listar eventos"
    },
    {
      "key": "seatId",
      "value": "",
      "description": "Preenchido ao buscar o mapa de assentos"
    },
    {
      "key": "reservationId",
      "value": "",
      "description": "Preenchido ao reservar"
    },
    {
      "key": "ticketCode",
      "value": "",
      "description": "Preenchido ao listar ingressos"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "description": "Gerada por requisição"
    },
    {
      "key": "papelAtual",
      "value": "",
      "description": "Papel autenticado no momento"
    },
    {
      "key": "meuEventoId",
      "value": "",
      "description": "Evento criado pela própria coleção"
    },
    {
      "key": "novaData",
      "value": "",
      "description": "Data gerada para o evento de exemplo"
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "description": "Cadastro público cria apenas CUSTOMER. Organizador e portaria vêm do seed.",
      "item": [
        {
          "name": "Login (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda a sessão nas variáveis da coleção.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente1@verzel.test\",\n  \"password\": \"cliente123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "const sessao = corpo.session ?? corpo;",
                  "",
                  "if (sessao.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', sessao.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', sessao.refreshToken);",
                  "  console.log('Sessão salva. Expira em', sessao.expiresIn, 'segundos.');",
                  "}",
                  "",
                  "pm.test('login bem-sucedido', () => pm.response.to.have.status(pm.response.code));",
                  "pm.collectionVariables.set('papelAtual', 'CUSTOMER');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (organizador)",
