# Copie para .env e preencha. O .env nunca é versionado.
# A aplicação recusa iniciar se alguma variável obrigatória faltar (RN-6).

# --- Aplicação ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Postgres ---
# Usadas pelo docker-compose para criar o container.
# DB_PORT e REDIS_PORT são a porta no host: mude se já houver um Postgres ou um
# Redis ocupando a padrão na sua máquina. A porta dentro do container não muda,
# então só DATABASE_URL e REDIS_URL precisam acompanhar.
DB_USER=verzel
DB_PASSWORD=troque-esta-senha
DB_NAME=verzel
DB_PORT=5432

# Usada pelo Prisma para conectar. Precisa refletir os valores acima.
DATABASE_URL="postgresql://verzel:troque-esta-senha@localhost:5432/verzel?schema=public"

# Banco separado para os testes de integração, no mesmo container.
# Criado por: docker compose exec postgres createdb -U $DB_USER verzel_test
TEST_DATABASE_URL="postgresql://verzel:troque-esta-senha@localhost:5432/verzel_test?schema=public"

# --- Redis ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
