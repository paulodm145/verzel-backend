# Copie para .env e preencha. O .env nunca é versionado.
# A aplicação recusa iniciar se alguma variável obrigatória faltar (RN-6).

# --- Aplicação ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Postgres ---
# Usadas pelo docker-compose para criar o container.
# DB_PORT e REDIS_PORT são a porta no host: mude se já houver um Postgres ou um
# Redis ocupando a padrão na sua máquina. A porta dentro do container não muda,
# então só DATABASE_URL e REDIS_URL precisam acompanhar.
DB_USER=verzel
DB_PASSWORD=troque-esta-senha
DB_NAME=verzel
DB_PORT=5432

# Usada pelo Prisma para conectar. Precisa refletir os valores acima.
DATABASE_URL="postgresql://verzel:troque-esta-senha@localhost:5432/verzel?schema=public"

# Banco separado para os testes de integração, no mesmo container.
# Criado por: docker compose exec postgres createdb -U $DB_USER verzel_test
TEST_DATABASE_URL="postgresql://verzel:troque-esta-senha@localhost:5432/verzel_test?schema=public"

# --- Redis ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- Autenticação ---
# Chave de assinatura dos tokens de acesso (HS256). Mínimo de 32 caracteres.
# Gere a sua: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres"

# Em segundos. Padrões: 15 minutos de acesso, 7 dias de renovação.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# --- Catálogo externo ---
# As duas chaves são opcionais: a fábrica instancia apenas o provedor que tiver
# a sua. Sem nenhuma, /catalog/search responde 200 com lista vazia.
# TMDb: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Ticketmaster Discovery: https://developer-acct.ticketmaster.com/user/register
TICKETMASTER_API_KEY=

# Prazo de cada chamada externa e TTL do cache de busca, em ms e em segundos.
CATALOG_TIMEOUT_MS=5000
CATALOG_CACHE_TTL=600

# --- Ingressos ---
# Assina o QR Code. Trocar este valor invalida os ingressos já emitidos.
# Gere o seu: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
TICKET_SECRET="troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres"

# Base dos links de compartilhamento de ingresso.
APP_BASE_URL="http://localhost:3000"

# Origens do frontend autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# Intervalo da limpeza de reservas vencidas e tokens antigos, em segundos.
HOUSEKEEPING_INTERVAL=300
